# Gradle
.gradle/
build/
*/build/

# Local configuration (sdk paths, etc.)
local.properties

# Node / Vite web build
node_modules/
dist/

# TypeScript incremental build state
tsconfig.tsbuildinfo
*.tsbuildinfo

# Log/OS files
*.log
.DS_Store
Thumbs.db

# Secrets and local environment files
# .env holds the developer's own panel key (VICTUS_USER_API); it must never be
# committed. .env.example is the documented template and stays tracked.
.env
.env.*
!.env.example

# Editor swap/backup leftovers
*.orig
*.rej
*~

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ / Android Studio
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files — never commit signing material
*.jks
*.keystore
keystore.properties
keystore-base64.txt

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# Kotlin
.kotlin/
