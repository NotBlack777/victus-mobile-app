<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only needed on API 23-28 for downloads into public storage.
         On API 29+ downloads go through MediaStore (scoped storage), no permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- In-app updater: hand a downloaded APK to the system package installer.
         Installing through Shizuku or root does not need this permission. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Package visibility (Android 11+). The app asks the platform about a handful of
      packages and nothing else, so it declares exactly those — which is also what
      makes custom-ROM support possible: the WebView provider is *queried* (Vanadium
      on GrapheneOS, org.lineageos.webview on LineageOS, Chromium on CalyxOS, Mulch
      from F-Droid) instead of assuming Google's package, and the diagnostics screen
      can only report what it is allowed to see. Without these entries every lookup
      silently returns "not installed" and the app would send custom-ROM users to a
      Play Store listing they cannot install from.
    -->
    <queries>
        <!-- WebView providers across stock Android and the AOSP family. -->
        <package android:name="com.google.android.webview" />
        <package android:name="com.android.webview" />
        <package android:name="com.android.chrome" />
        <package android:name="org.chromium.chrome" />
        <package android:name="app.vanadium.webview" />
        <package android:name="org.lineageos.webview" />
        <package android:name="us.spotco.mulch_wv" />
        <package android:name="com.system.webview" />
        <!-- What is installed: Google services, the Play Store, F-Droid. -->
        <package android:name="com.google.android.gms" />
        <package android:name="com.android.vending" />
        <package android:name="org.fdroid.fdroid" />
        <!-- Needed to resolve a Play listing before starting it. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Victus.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Let taps on victuscloud.com links offer to open in the app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="victuscloud.com" />
                <data android:scheme="https" android:host="*.victuscloud.com" />
            </intent-filter>
            <!-- Long-press launcher shortcuts (res/xml/shortcuts.xml) arrive as
                 victus:// ACTION_VIEW intents. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="victus" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- In-app updater: serves downloaded APKs to the system package installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Shizuku: lets the updater install as the ADB/shell identity (no root
             and no unknown-sources prompt). The INTERACT_ACROSS_USERS_FULL
             permission keeps this provider off-limits to other apps, as the
             Shizuku developer guide requires. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
