<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark variant of the app theme (the original Victus look). -->
    <style name="Theme.Victus" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/brand_blue</item>
    </style>

    <style name="Theme.Victus.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Victus</item>
    </style>
</resources>
